root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,js,mjs,ts,mts,vue,css,xml}]
indent_size = 2

[docs/**.{json,sh}]
indent_size = 2

# Generated by docs/scripts/render-diagrams.mjs
[docs/diagrams/*.json]
indent_size = 1
insert_final_newline = unset

# Generated by docs/scripts/render-diagrams.mjs
[docs/diagrams/*.excalidraw]
indent_size = 2

[docs/scripts/check-svg.py]
indent_size = 4

[docs/scripts/check-snippets.py]
indent_size = 2

[examples/frameworks/nette/**.neon]
indent_style = tab

# Code blocks may contain tabs (Makefile, NEON)
[*.md]
indent_style = unset
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
