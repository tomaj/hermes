{
    "name": "tomaj/hermes",
    "description": "Simple php background processing library",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "event",
        "background",
        "workers"
    ],
    "authors": [
        {
            "name": "Tomas Majer",
            "email": "tomasmajer@gmail.com",
            "homepage": "http://www.tomaj.sk/"
        }
    ],
    "homepage": "https://github.com/tomaj/hermes",
    "support": {
        "issues": "https://github.com/tomaj/hermes/issues",
        "source": "https://github.com/tomaj/hermes"
    },
    "require": {
        "php": "^8.4",
        "psr/log": "^2 || ^3",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "ext-redis": "*",
        "aws/aws-sdk-php": "^3.337",
        "friendsofphp/php-cs-fixer": "^3.64",
        "infection/infection": "^0.35",
        "php-amqplib/php-amqplib": "^3.7",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0.5",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^13.2",
        "predis/predis": "^2.3 || ^3.0",
        "rector/rector": "2.7.0",
        "tracy/tracy": "^2.10.10"
    },
    "suggest": {
        "ext-pcntl": "Lets the worker finish the current message and stop on SIGTERM and SIGINT",
        "ext-redis": "Needed for RedisSetDriver and RedisShutdown (native Redis extension)",
        "aws/aws-sdk-php": "Needed for AmazonSqsDriver (Amazon SQS)",
        "monolog/monolog": "A PSR-3 logger to pass to Emitter and Dispatcher",
        "php-amqplib/php-amqplib": "Needed for LazyRabbitMqDriver (RabbitMQ)",
        "predis/predis": "Needed for PredisSetDriver and PredisShutdown (Redis without the extension)",
        "tracy/tracy": "Dispatcher also writes handler and driver exceptions to Tracy when Debugger is enabled"
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Tomaj\\Hermes\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tomaj\\Hermes\\Test\\": "tests"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "check": [
            "@phpcs",
            "@phpstan",
            "@rector",
            "@test"
        ],
        "coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "phpunit --coverage-clover build/logs/clover.xml --coverage-html build/coverage"
        ],
        "cs-fix": "php-cs-fixer fix",
        "infection": [
            "@putenv XDEBUG_MODE=coverage",
            "infection --threads=max"
        ],
        "phpcs": "php-cs-fixer fix --dry-run --diff --verbose",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "phpunit": "phpunit --no-coverage",
        "rector": "rector --dry-run",
        "rector-fix": "rector",
        "test": "@phpunit",
        "test:integration": [
            "@putenv HERMES_TEST_REDIS=tcp://127.0.0.1:6379",
            "@putenv HERMES_TEST_RABBITMQ=127.0.0.1",
            "@putenv HERMES_TEST_SQS=http://127.0.0.1:4566",
            "@putenv HERMES_REQUIRE_SERVICES=1",
            "phpunit --no-coverage"
        ]
    }
}
