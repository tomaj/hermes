flowchart TD
  emitted["Emitted"] --> future{"executeAt in the future on Redis or Predis?"}
  future -->|yes| scheduled["Scheduled"]
  future -->|no| queued["Queued"]
  scheduled --> queued
  queued --> processing["Processing, already removed from the broker"]
  processing --> done["Done, handler returned true"]
  processing --> failed["Failed, false or no retries left"]
  processing --> retry["Retry, a copy is sent"]
  retry --> future
