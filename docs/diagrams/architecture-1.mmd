flowchart TD
  code["Your controller"] --> emitter["Emitter"]
  emitter --> send["Driver.send"]
  send --> broker["Redis, RabbitMQ, or SQS"]
  broker --> wait["Driver.wait"]
  wait --> dispatch["Dispatcher"]
  dispatch --> handler["Handler.handle"]
  handler --> outcome["true, false, or exception"]
  outcome --> retry["send a copy"]
  retry --> broker
